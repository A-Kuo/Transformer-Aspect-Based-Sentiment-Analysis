# Copy this file to .env and fill in real values.
# .env is already gitignored — never commit real credentials.

# Neon Postgres connection string for this repo's ABSA model registry
# (absa_runs / absa_example_predictions tables, see db/schema.sql).
# Accepts a bare postgresql:// or postgres:// URL; src/db.py normalizes
# it to the psycopg3 driver form.
DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# A [connections.postgresql] TOML block (the Streamlit secrets.toml shape)
# also works in .env instead of DATABASE_URL above — src/db.py reads
# either. Example:
#
# [connections.postgresql]
# url = "postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional. Only needed if the Hugging Face model repo holding trained
# checkpoints (notebooks/kaggle_train_and_push.ipynb pushes to it) is
# private. Leave blank/unset for a public repo.
HF_TOKEN=
